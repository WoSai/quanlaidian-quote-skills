#!/usr/bin/env bash
# commit-msg 钩子：提交标题必须符合 Conventional Commits。
#
# release-please 据 commit 前缀出版本,前缀乱写(如拿分支名当标题)会漏进 changelog /
# 不触发版本。这条原先只在 CLAUDE.md 口头约束,这里在提交时强制拦下。
# 经 .claude SessionStart 的 `git config core.hooksPath .githooks` 自动启用;
# 人工启用同理:在仓库根跑一次 `git config core.hooksPath .githooks`。

msg_file="$1"
[ -r "$msg_file" ] || exit 0

# 第一条非空、非注释行即提交标题
subject="$(grep -v '^#' "$msg_file" 2>/dev/null | grep -vE '^[[:space:]]*$' | head -n1)"
[ -z "$subject" ] && exit 0   # 空标题交给 git 自己的空消息检查

case "$subject" in
  "Merge "* | "Revert "* | "fixup!"* | "squash!"*) exit 0 ;;
esac

types='feat|fix|docs|refactor|perf|revert|chore|test|build|ci|style'
if printf '%s' "$subject" | grep -Eq "^(${types})(\([^)]+\))?!?: .+"; then
  exit 0
fi

cat >&2 <<EOF
✗ commit 标题不符合 Conventional Commits：
    ${subject}

  需形如：  <type>[(scope)][!]: <描述>
  type 取值：${types}
  例：      feat: 新增大客户段多档对比
            fix(quote): 修正供应链版套餐互斥
  (release-please 据此出版本，前缀写错会漏进 changelog)
EOF
exit 1
